# Copie este arquivo para .env e preencha os valores

# Chave da API Claude (obtenha em https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Caminhos — use barras normais (/) ou barras duplas (\\) no Windows
# Exemplo Windows:
# DISSERTACAO_PATH=E:\mestrado\dissertacao final 1.docx
# REFERENCIAS_FOLDER=E:\fusion centers

# Exemplo Linux/Mac (pen drive montado em /media):
# DISSERTACAO_PATH=/media/usuario/PENDRIVE/mestrado/dissertacao final 1.docx
# REFERENCIAS_FOLDER=/media/usuario/PENDRIVE/fusion centers

DISSERTACAO_PATH=
REFERENCIAS_FOLDER=

# Pasta onde o relatório será salvo (padrão: relatorio_saida/)
OUTPUT_DIR=relatorio_saida
